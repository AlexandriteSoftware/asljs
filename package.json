{
  "name": "asljs",
  "private": true,
  "license": "MIT",
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "type": "module",
  "scripts": {
    "format:json": "dprint fmt --config ./dprint.json \"*.json\"",
    "format:md": "dprint fmt --config ./dprint.json \"*.md\" \"tasks/*.md\"",
    "format": "npm run format:json && npm run format:md",
    "check-packages": "npm outdated || project-tools print-file check-packages.md",
    "remove-local-modules": "project-tools clean cog/node_modules project-tools/node_modules components/node_modules dali/node_modules dash/node_modules data-binding/node_modules eventful/node_modules kb/node_modules logging/node_modules machine/node_modules money/node_modules observable/node_modules part/node_modules tmpdir/node_modules",
    "all": "project-tools run-all"
  },
  "workspaces": [
    "app-builder",
    "cog",
    "components",
    "dali",
    "dash",
    "data-binding",
    "eventful",
    "kb",
    "logging",
    "machine",
    "money",
    "observable",
    "part",
    "project-tools",
    "sfmt",
    "tmpdir"
  ],
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/yargs": "^17.0.35",
    "acorn": "^8.17.0",
    "asljs-sfmt": "^0.1.5",
    "asljs-tmpdir": "^0.1.9",
    "dprint": "^0.57.4",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.7.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.6",
    "pkg-types": "^2.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4"
  },
  "version": "1.0.0",
  "allowScripts": {
    "dprint": true,
    "esbuild": true,
    "puppeteer": true
  }
}
