{
  "name": "asljs",
  "private": true,
  "license": "MIT",
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "type": "module",
  "scripts": {
    "flint": "toolkit flint --exclude aftefacts --exclude apps --exclude libs",
    "check-packages": "npm outdated || toolkit print-file check-packages.md",
    "remove-local-modules": "toolkit remove-local-modules",
    "all": "toolkit run-all"
  },
  "workspaces": [
    "aftefacts",
    "apps/app-builder",
    "apps/cog",
    "apps/dash",
    "apps/kb",
    "apps/part",
    "apps/sfmt",
    "apps/toolkit",
    "libs/components",
    "libs/dali",
    "libs/data-binding",
    "libs/eventful",
    "libs/locator",
    "libs/logging",
    "libs/machine",
    "libs/money",
    "libs/observable",
    "libs/testing",
    "libs/tmpdir"
  ],
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/yargs": "^17.0.35",
    "acorn": "^8.17.0",
    "asljs-sfmt": "^0.1.5",
    "asljs-tmpdir": "^0.1.9",
    "dprint": "^0.58.0",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.7.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.6",
    "pkg-types": "^2.3.1",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-maximum-line-length": "^4.1.1",
    "remark-validate-links": "^13.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.1.4"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "glob": "^13.0.6"
  },
  "version": "1.0.0",
  "allowScripts": {
    "dprint": true,
    "esbuild": true
  }
}
