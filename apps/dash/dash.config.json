{
  "project": "machine",
  "label": "Machine",
  "db": ".dash/dash.sqlite",
  "samples": "database, 90*24h, 100k, 100Mb",

  "counters": {
    "disk.c": {
      "schedule": "*/5 * * * *",
      "command": "pwsh -NoProfile -File agents/disk.c.ps1"
    },
    "ping.gw": {
      "schedule": "* * * * *",
      "command": "pwsh -NoProfile -File agents/ping.gw.ps1",
      "samples": "database, 30*24h, 50k, 20Mb"
    },
    "top.cpu": {
      "schedule": "*/2 * * * *",
      "command": "pwsh -NoProfile -File agents/top.cpu.ps1",
      "samples": "memory, 1h, 200, 2Mb"
    },
    "uptime": {
      "schedule": "*/10 * * * *",
      "command": "pwsh -NoProfile -File agents/uptime.ps1"
    },
    "network": {
      "schedule": "0 * * * *",
      "startup": true,
      "command": "pwsh -NoProfile -File agents/network.ps1"
    },
    "windows.updates": {
      "schedule": "0 6 * * *",
      "startup": true,
      "command": "pwsh -NoProfile -File agents/windows.updates.ps1"
    },
    "notes": { "samples": "database, 365*24h, 1k, 1Mb" }
  },

  "tabs": [
    {
      "tab": "system",
      "label": "System",
      "cards": [
        {
          "key": "disk.c",
          "label": "Disk C: free",
          "render": "value",
          "left": 0,
          "top": 0,
          "width": 7,
          "height": 4,
          "params": { "field": "freePercent", "unit": "%", "precision": 1 }
        },
        {
          "key": "disk.c",
          "label": "Disk C: free trend",
          "render": "chart",
          "width": 13,
          "height": 4,
          "params": { "field": "freePercent", "limit": 300, "kind": "line", "unit": "%", "precision": 1 }
        },
        {
          "key": "ping.gw",
          "label": "Gateway",
          "render": "status",
          "width": 5,
          "height": 4
        },
        {
          "key": "ping.gw",
          "label": "Gateway latency",
          "render": "chart",
          "width": 13,
          "height": 4,
          "params": { "field": "ms", "limit": 300, "unit": " ms" }
        },
        {
          "key": "top.cpu",
          "label": "Top CPU",
          "render": "list",
          "width": 7,
          "height": 8,
          "params": { "fields": ["label", "cpu"], "limit": 8 }
        },
        {
          "key": "uptime",
          "label": "Uptime",
          "render": "value",
          "width": 5,
          "height": 4,
          "params": { "field": "days", "unit": "d", "precision": 1 }
        },
        {
          "key": "network",
          "label": "Network",
          "render": "table",
          "width": 13,
          "height": 5,
          "params": {
            "columns": [
              { "field": "label", "label": "Interface" },
              { "field": "ip", "label": "IP" },
              { "field": "gateway", "label": "Gateway" }
            ],
            "empty": "no active interface"
          }
        },
        {
          "key": "windows.updates",
          "label": "Windows updates",
          "render": "list",
          "width": 13,
          "height": 6,
          "params": { "fields": ["label", "kb"], "limit": 8, "empty": "up to date" }
        }
      ]
    },
    {
      "tab": "day",
      "label": "Day",
      "cards": [
        {
          "key": "calendar.due",
          "label": "Due in 5 days",
          "render": "list",
          "width": 11,
          "height": 8,
          "params": { "fields": ["label", "due"], "limit": 10, "empty": "nothing due" }
        },
        {
          "key": "notes",
          "label": "Notes",
          "render": "text",
          "width": 11,
          "height": 8,
          "params": { "wrap": true }
        }
      ]
    }
  ]
}
