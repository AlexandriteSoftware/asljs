{
  "name": "asljs-dash",
  "version": "0.1.0",
  "description": "Personal, agent-fed performance dashboard — Node server, SQLite store, static page.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "flint": "toolkit flint",
    "clean": "toolkit clean",
    "start": "node src/server.js --config dash.config.json --config ../../dash.config.json",
    "start:with-runner": "node src/server.js --with-runner --config dash.config.json --config ../../dash.config.json",
    "runner": "node src/runner.js --config dash.config.json --config ../../dash.config.json",
    "once": "node src/runner.js --once --config dash.config.json --config ../../dash.config.json",
    "test": "node --test \"src/**/*.test.js\" \"agents/*.test.js\"",
    "all": "npm run clean && npm run flint && npm run test"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "asljs-testing": "^0.1.0",
    "asljs-tmpdir": "^0.1.13",
    "asljs-toolkit": "^0.1.0",
    "jsdom": "^30.1.1"
  }
}
