{
  "name": "asljs-part",
  "version": "0.1.42",
  "description": "Project artefact tracing framework and CLI for markdown-defined project artefacts.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "artefacts/parts/testing/*.js",
    "artefacts/parts/Artefact Definition*.js",
    "artefacts/parts/Rule File*.js",
    "artefacts/Artefact Definition.md",
    "artefacts/Rule File.md",
    "dist/**",
    "bin/**",
    "README.md",
    "LICENSE.md"
  ],
  "bin": {
    "part": "bin/part.js"
  },
  "scripts": {
    "flint": "toolkit flint",
    "clean": "toolkit clean",
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "guard:clean-git": "toolkit ensure-clean-working-directory",
    "prepack": "npm run clean && npm run build:dist && npm run build && npm run test && npm run guard:clean-git",
    "postpublish": "toolkit tag-release-revision",
    "test": "node --test --enable-source-maps build/**/*.test.js artefacts/**/*.test.js",
    "release:patch": "toolkit release-patch",
    "all": "npm run clean && npm run flint && npm run typecheck && npm run build:dist && npm run build && npm run test"
  },
  "keywords": [
    "traceability",
    "artefacts",
    "requirements",
    "markdown",
    "cli"
  ],
  "homepage": "https://github.com/AlexandriteSoftware/asljs#readme",
  "bugs": {
    "url": "https://github.com/AlexandriteSoftware/asljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandriteSoftware/asljs.git"
  },
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "asljs-locator": "^0.1.0",
    "asljs-logging": "^0.1.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.6",
    "minimatch": "^10.2.5",
    "remark-parse": "^11.0.0",
    "typescript-eslint": "^8.64.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "asljs-toolkit": "^0.1.0"
  }
}
