{
  "name": "asljs-app-builder",
  "version": "0.1.0",
  "description": "Static site for ASLJS, generated from the repository's markdown files; also holds the App Builder demo's sources.",
  "private": true,
  "type": "module",
  "scripts": {
    "flint": "toolkit flint",
    "clean": "toolkit clean",
    "dev": "vite",
    "build": "node --import tsx src/site/build-site.ts && mkdocs build --strict",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "all": "npm run clean && npm run flint",
    "all:todo": "npm run typecheck && npm run build:dist && npm run build && npm run test"
  },
  "dependencies": {
    "asljs-components": "^0.1.3",
    "asljs-dali": "^0.1.4",
    "asljs-data-binding": "^0.2.4",
    "asljs-eventful": "^0.4.10",
    "asljs-observable": "^0.5.4",
    "esbuild": "^0.28.1",
    "esbuild-wasm": "^0.28.1"
  },
  "devDependencies": {
    "asljs-testing": "^0.1.0",
    "asljs-toolkit": "^0.1.0",
    "marked": "^18.0.6"
  }
}
