{
  "name": "asljs-machine",
  "version": "0.3.0",
  "description": "Compact and powerful library for structuring control flow with state machines.",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "state-machine",
    "javascript",
    "js"
  ],
  "homepage": "https://github.com/AlexandriteSoftware/asljs#readme",
  "bugs": {
    "url": "https://github.com/AlexandriteSoftware/asljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandriteSoftware/asljs.git"
  },
  "license": "MIT",
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "flint": "toolkit flint",
    "clean": "toolkit clean",
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "example": "tsx examples/run-document-agent.ts",
    "guard:clean-git": "toolkit ensure-clean-working-directory",
    "prepack": "npm run clean && npm run build && npm run test && npm run build:dist && npm run guard:clean-git",
    "postpublish": "toolkit tag-release-revision",
    "test": "node --test --enable-source-maps build/**/*.test.js",
    "test:watch": "node --watch --test build/**/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage --enable-source-maps --test-coverage-exclude=\"**/*.test.js\" build/**/*.test.js",
    "release:patch": "toolkit release-patch",
    "all": "npm run clean && npm run flint && npm run typecheck && npm run build:dist && npm run build && npm run test"
  },
  "dependencies": {
    "asljs-eventful": "^0.4.10",
    "asljs-observable": "^0.5.4"
  },
  "devDependencies": {
    "asljs-toolkit": "^0.1.0"
  }
}
