{
  "name": "asljs-testing",
  "version": "0.1.0",
  "description": "Test helpers: temporary environment variables and globals, waiting for a condition, and the test logger.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "flint": "toolkit flint",
    "clean": "toolkit clean",
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "guard:clean-git": "toolkit ensure-clean-working-directory",
    "prepack": "npm run clean && npm run build && npm run test && npm run build:dist && npm run guard:clean-git",
    "postpublish": "toolkit tag-release-revision",
    "test": "node --test --enable-source-maps build/**/*.test.js",
    "test:watch": "node --watch --test build/**/*.test.js",
    "release:patch": "toolkit release-patch",
    "all": "npm i && npm run clean && npm run flint && npm run typecheck && npm run build:dist && npm run build && npm run test"
  },
  "keywords": [
    "tests",
    "testing",
    "environment",
    "globals",
    "jsdom",
    "helpers"
  ],
  "homepage": "https://github.com/AlexandriteSoftware/asljs#readme",
  "bugs": {
    "url": "https://github.com/AlexandriteSoftware/asljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandriteSoftware/asljs.git"
  },
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "asljs-logging": "^0.1.2"
  },
  "devDependencies": {
    "asljs-toolkit": "^0.1.0"
  }
}
