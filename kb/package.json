{
  "name": "asljs-kb",
  "version": "0.1.0",
  "description": "Knowledge base tooling: CLI and MCP server for markdown library management.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "bin/**",
    "README.md",
    "LICENSE.md"
  ],
  "bin": {
    "kb": "bin/kb.js",
    "kb-mcp": "bin/kb-mcp.js"
  },
  "scripts": {
    "format:json": "dprint fmt --config ../dprint.json \"*.json\"",
    "format:ts": "dprint fmt --config ../dprint.json \"src/**/*.ts\"",
    "format:sfmt": "sfmt format \"src/**/*.ts\"",
    "format": "npm run format:json && npm run format:ts && npm run format:sfmt",
    "clean": "node ../common/dist/toolkit.js clean",
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "guard:clean-git": "node ../common/dist/toolkit.js ensure-clean-working-directory",
    "prepack": "npm run clean && npm run build:dist && npm run build && npm run test && npm run guard:clean-git",
    "postpublish": "node ../common/dist/toolkit.js tag-release-revision",
    "test": "node --test --enable-source-maps \"build/**/*.test.js\"",
    "test:watch": "node --watch --test \"build/**/*.test.js\"",
    "release:patch": "node ../common/dist/toolkit.js release-patch",
    "all": "npm run clean && npm run format && npm run typecheck && npm run lint && npm run build:dist && npm run build && npm run test"
  },
  "keywords": [
    "knowledge-base",
    "markdown",
    "notes",
    "search",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/AlexandriteSoftware/asljs#readme",
  "bugs": {
    "url": "https://github.com/AlexandriteSoftware/asljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandriteSoftware/asljs.git"
  },
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "asljs-logging": "^0.1.1",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.9",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "asljs-tmpdir": "^0.1.13"
  }
}
