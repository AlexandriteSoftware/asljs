{
  "name": "asljs-observable",
  "version": "0.5.4",
  "description": "Lightweight observable for JS. Emits events on property changes via on/off/emit. Works with plain objects, arrays, and primitives.",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "events",
    "javascript",
    "js"
  ],
  "homepage": "https://github.com/AlexandriteSoftware/asljs#readme",
  "bugs": {
    "url": "https://github.com/AlexandriteSoftware/asljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandriteSoftware/asljs.git"
  },
  "license": "MIT",
  "author": "\"Alex Netkachov\" <alex.netkachov@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:json": "dprint fmt --config ../dprint.json \"*.json\"",
    "format:ts": "dprint fmt --config ../dprint.json \"src/**/*.ts\"",
    "format:sfmt": "sfmt format \"src/**/*.ts\"",
    "format": "npm run format:json && npm run format:ts && npm run format:sfmt",
    "clean": "project-tools clean",
    "build": "tsc -p tsconfig.build.json",
    "build:dist": "tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "guard:clean-git": "project-tools ensure-clean-working-directory",
    "prepack": "npm run clean && npm run build && npm run test && npm run build:dist && npm run guard:clean-git",
    "postpublish": "project-tools tag-release-revision",
    "test": "node --test --enable-source-maps build/**/*.test.js",
    "test:watch": "node --watch --test build/**/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage --enable-source-maps --test-coverage-exclude=\"**/*.test.js\" build/**/*.test.js",
    "release:patch": "project-tools release-patch",
    "all": "npm run clean && npm run format && npm run typecheck && npm run lint && npm run build:dist && npm run build && npm run test"
  },
  "dependencies": {
    "asljs-eventful": "^0.4.10"
  },
  "devDependencies": {
    "asljs-project-tools": "^0.1.0"
  }
}
