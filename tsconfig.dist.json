{
  "include": ["${configDir}/src/**/*.ts"],
  "exclude": ["${configDir}/src/**/*.test.ts", "${configDir}/src/**/testing/**"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": []
  }
}
